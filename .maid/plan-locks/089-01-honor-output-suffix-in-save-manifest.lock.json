                }
              ],
              "returns": "None",
              "source_scenario": "A caller saves a manifest to a .txt path, which MAID cannot load, and a sentinel file already occupies that path.",
              "actions": [
                {
                  "type": "api_call",
                  "subject": {
                    "export": "save_manifest"
                  }
                }
              ],
              "expected": {
                "behavior": "save_manifest raises ValueError naming the unsupported suffix and the sentinel bytes are untouched, proving the suffix is validated before any filesystem effect rather than rolled back after one."

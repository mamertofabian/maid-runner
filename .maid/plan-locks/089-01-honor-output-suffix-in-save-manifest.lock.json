                  "type": "Path"
                }
              ],
              "returns": "None",
              "source_scenario": "A caller saves a manifest to an uppercase .YAML path.",
              "actions": [
                {
                  "type": "api_call",
                  "subject": {
                    "export": "save_manifest"
                  }
                }
              ],
              "expected": {
                "behavior": "save_manifest raises ValueError and writes nothing, because load_manifest_raw and manifest chain discovery match the lowercase suffix exactly, so an uppercase suffix is not a loadable manifest."

            {
              "kind": "test_function",
              "name": "test_strict_preview_propagates_strict_defaults_to_nested_validation",
              "returns": "None",
              "source_scenario": "An outer manifest's coverage test invokes default `maid validate` on an inner manifest whose declared function is a stub.",
              "actions": [
                {
                  "type": "api_call",
                  "subject": {
                    "command": "maid validate manifests/outer.manifest.yaml --mode schema --no-chain --artifact-coverage --json"
                  }
                },
                {
                  "type": "api_call",
                  "subject": {
                    "command": "maid validate manifests/outer.manifest.yaml --mode schema --no-chain --strict-preview --json"
                  }
                }
              ],
              "expected": {
                "behavior": "Plain artifact coverage succeeds because the nested call keeps legacy defaults; strict-preview fails with top-level strict_preview=true and E900 because the nested call inherits strict stub checking; a second plain coverage run succeeds, proving strict context is restored and does not leak after preview execution."
              }
            },
            {
              "kind": "test_function",
              "name": "test_strict_delta_reports_nested_default_gate_regression_without_failing_default_side",
              "returns": "None",
              "source_scenario": "The same nested-validation fixture is compared through strict-delta with explicit default-side artifact coverage.",
              "actions": [
                {
                  "type": "api_call",
                  "subject": {
                    "command": "maid validate manifests/outer.manifest.yaml --mode schema --no-chain --artifact-coverage --strict-delta --json"
                  }
                }
              ],
              "expected": {
                "behavior": "The command exits zero from the successful legacy default side, while strict_delta contains an E900 artifact-coverage command failure attributable to the outer manifest and caused by the nested strict E310 failure."
              }
            },
            {
              "kind": "test_function",
              "name": "test_inherited_strict_boundary_blocks_explicit_nested_coverage_modes",
              "returns": "None",
              "source_scenario": "An outer strict-preview coverage test invokes a clean nested MAID validation that explicitly requests artifact coverage, strict-preview, or strict-delta; a fixture counter fails immediately if the same test command is entered twice.",
              "actions": [
                {
                  "type": "api_call",
                  "subject": {
                    "command": "maid validate manifests/outer.manifest.yaml --mode schema --no-chain --strict-preview --json"
                  }
                }
              ],
              "expected": {
                "behavior": "Every explicit nested coverage-producing mode completes successfully with exactly one execution of the outer test, proving the inherited strict marker is an active non-reentrant coverage boundary while structural strictness remains enabled."
              }
            },
            {
              "kind": "test_function",

              "name": "test_open_release_pr_without_merge_commit_is_reused",
              "returns": "None",
              "source_scenario": "GitHub returns a stripped three-field record for an open release PR whose merge commit is null.",
              "actions": [
                {
                  "type": "api_call",
                  "subject": {
                    "export": "PRCreator.find_release_pr"
                  }
                }
              ],
              "expected": {
                "behavior": "The lookup returns the exact open PR metadata with an empty merge_commit value instead of raising an unpacking error."
              }
            },
            {
              "kind": "test_function",
              "name": "test_merged_release_pr_is_preferred_and_preserves_merge_commit",
              "returns": "None",
              "source_scenario": "GitHub returns both open and merged four-field records for the reviewed head.",
              "actions": [
                {
                  "type": "api_call",
                  "subject": {
                    "export": "PRCreator.find_release_pr"
                  }
                }
              ],
              "expected": {
                "behavior": "The lookup prefers the merged record and preserves its merge commit SHA."
              }
            },
            {
              "kind": "test_function",
              "name": "test_malformed_release_pr_record_fails_with_specific_error",
              "returns": "None",
              "source_scenario": "GitHub returns a release PR record with neither the supported three-field nor four-field shape.",
              "actions": [
                {
                  "type": "api_call",
                  "subject": {
                    "export": "PRCreator.find_release_pr"
                  }
                }
              ],
              "expected": {
                "behavior": "The lookup raises a release-specific RuntimeError rather than leaking an incidental tuple-unpack exception or fabricating data."
              }
            },
            {
              "kind": "test_function",
              "name": "test_merged_release_pr_without_merge_commit_fails_with_specific_error",
              "returns": "None",
              "source_scenario": "GitHub returns a stripped three-field record marked as merged even though its merge commit is absent.",
              "actions": [
                {
                  "type": "api_call",
                  "subject": {
                    "export": "PRCreator.find_release_pr"
                  }
                }
              ],
              "expected": {
                "behavior": "The lookup rejects the malformed merged record with a release-specific RuntimeError instead of treating it as an open PR shape."
              }
            }
          ]

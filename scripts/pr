#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

if ! command -v uv >/dev/null 2>&1; then
    echo "error: uv is required to run scripts/pr" >&2
    exit 127
fi

exec uv run --project "$PROJECT_ROOT" python "$SCRIPT_DIR/pr.py" "$@"
